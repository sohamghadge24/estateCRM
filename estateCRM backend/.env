# EstateOS Local Development Configuration
APP_NAME="EstateOS"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database: Uses the seeded SQLite database for instant zero-dependency local dev
# To switch to MySQL: comment out DATABASE_URL_OVERRIDE and set MYSQL_* credentials below
DATABASE_URL_OVERRIDE="sqlite:///estateos_dev.db"

# MySQL Production Configuration (Used when running in Docker or connected to MySQL)
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_DATABASE="estateos_db"
MYSQL_USER="estateos_user"
MYSQL_PASSWORD="estateos_password"

# Security & Tokens
JWT_SECRET_KEY="dev-super-secure-jwt-secret-key-32chars-min"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL="redis://localhost:6379/0"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]


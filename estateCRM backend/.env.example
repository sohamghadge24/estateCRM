# EstateOS Backend Environment Configuration
PROJECT_NAME="EstateOS Backend"
ENVIRONMENT="production"
PORT=8000

# Database (MySQL 8.0+ InnoDB utf8mb4)
DATABASE_URL="mysql+pymysql://estateos_user:estateos_password@localhost:3306/estateos_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Security & JWT (Argon2id + PyJWT)
JWT_SECRET_KEY="replace-this-with-a-secure-random-64-character-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# S3 / MinIO Object Storage
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadminpassword"
S3_BUCKET_NAME="estateos-vault"
S3_REGION_NAME="ap-south-1"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

